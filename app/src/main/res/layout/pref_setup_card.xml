<?xml version="1.0" encoding="utf-8"?>
<!-- the wrapper's padding keeps the card clear of the preference list's divider lines -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <com.google.android.material.card.MaterialCardView     style="?attr/materialCardViewFilledStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="0dp"
        app:cardCornerRadius="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/setup_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get started"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <include android:id="@+id/step1" layout="@layout/setup_step" />
            <include android:id="@+id/step2" layout="@layout/setup_step" />
            <include android:id="@+id/step3" layout="@layout/setup_step" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>

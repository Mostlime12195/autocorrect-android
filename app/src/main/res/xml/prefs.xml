<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android">
        <dev.mostlime.autocorrect.ui.SetupCard app:key="setup_card" />
        <dev.mostlime.autocorrect.ui.ModelCard app:key="model_card" />
        <Preference app:key="update_banner" app:title="Update available" app:isPreferenceVisible="false" app:iconSpaceReserved="false" />

    <PreferenceCategory app:title="Settings" app:iconSpaceReserved="false">
        <Preference app:key="screen_typing" app:title="Typing" app:summary="Capitals, swipe, long-press, vibration, clipboard" app:fragment="dev.mostlime.autocorrect.ui.SettingsActivity$Fragment" app:iconSpaceReserved="false" />
        <Preference app:key="screen_correction" app:title="Correction" app:summary="Style, auto-correct or suggest only" app:fragment="dev.mostlime.autocorrect.ui.SettingsActivity$Fragment" app:iconSpaceReserved="false" />
        <Preference app:key="screen_dictionary" app:title="Dictionary" app:summary="Your words, learning from undos" app:fragment="dev.mostlime.autocorrect.ui.SettingsActivity$Fragment" app:iconSpaceReserved="false" />
        <Preference app:key="screen_appearance" app:title="Appearance" app:summary="Theme, color, background, layout, keys" app:fragment="dev.mostlime.autocorrect.ui.SettingsActivity$Fragment" app:iconSpaceReserved="false" />
        <Preference app:key="screen_performance" app:title="Performance" app:summary="Presets, context length, re-checking, threads, usage meter" app:fragment="dev.mostlime.autocorrect.ui.SettingsActivity$Fragment" app:iconSpaceReserved="false" />
        <Preference app:key="screen_model" app:title="Model" app:summary="Model choice, download, stats" app:fragment="dev.mostlime.autocorrect.ui.SettingsActivity$Fragment" app:iconSpaceReserved="false" />
